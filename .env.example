# GROQ_API_KEY: High-speed LLM provider for PlanCraft AI Engine (Primary)
# Get your free key at https://console.groq.com
GROQ_API_KEY="gsk_your_groq_api_key_here"

# GROQ_MODEL: Default model is qwen/qwen3.8-27b or llama-3.3-70b-versatile
GROQ_MODEL="qwen/qwen3.8-27b"

# GEMINI_API_KEY: Secondary fallback provider (Google Gemini 2.5 Flash)
# AI Studio automatically injects this or provide your AI Studio key
GEMINI_API_KEY="your_gemini_api_key_here"

# VITE_API_URL: Required when frontend is deployed on Vercel and backend is on Render.
# Example: https://plancraft-ai.onrender.com (leave empty for local dev)
VITE_API_URL=""

# SESSION_SECRET: Secret for HMAC-SHA256 session token signing
SESSION_SECRET="your-cryptographic-session-secret-min-32-chars"

# APP_URL: Optional hosting origin URL
APP_URL="http://localhost:3000"
